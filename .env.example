# ---- Server ----
PORT=3000
# Public origin of this app. Must exactly match the OAuth redirect URI host
# and the origin the PWA is served from. Use https:// in production.
BASE_URL=http://localhost:3000

# Random string used to sign the session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# ---- Google OAuth (Web application client) ----
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# Application type: "Web application"
# Authorized redirect URI: http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Web Push (VAPID) ----
# Generate with: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Behaviour ----
# How often the scheduler checks every user's calendar, in seconds.
CHECK_INTERVAL_SECONDS=60
# Default minutes-before-start for a new user (they can change it in Settings).
DEFAULT_LEAD_MINUTES=5
