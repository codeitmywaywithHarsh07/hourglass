# ---- Database (required) ----
# Any Postgres. On Vercel, attaching a Postgres store injects POSTGRES_URL
# automatically and you can leave this unset there.
# Locally: a free Neon database (https://neon.tech) is the quickest route.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Server ----
PORT=3000
# Public origin. Must exactly match the OAuth redirect URI host and the origin
# the PWA is served from. No trailing slash. In production: https://...
BASE_URL=http://localhost:3000

# Signs the session cookie.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me

# ---- Google OAuth (Web application client) ----
# Google Cloud Console > APIs & Services > Credentials > Create OAuth client ID
# Application type: "Web application"
# Authorized redirect URIs: http://localhost:3000/auth/callback
#                           https://<your-domain>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Web Push (VAPID) ----
# Generate: npm run keys
# Keep these stable — changing them invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Scheduling ----
# Shared secret for /api/tick. Required in production: without it the endpoint
# refuses to run when deployed, so nobody can burn your Calendar quota.
# Generate: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
CRON_SECRET=

# Only used by the local in-process scheduler (npm start). In production the
# cadence is whatever calls /api/tick.
CHECK_INTERVAL_SECONDS=60

# Default minutes-before-start for a new user (changeable in Settings).
DEFAULT_LEAD_MINUTES=5
